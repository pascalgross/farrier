# Copy to .env beside compose.yaml and fill in. Compose reads it automatically.
#
#   cp .env.example .env
#
# Every value without a default below is required, and `docker compose up` says which one is missing
# rather than starting something half-configured. .env is gitignored; treat it as you would the database
# it grants access to.
#
# Generate the secrets rather than inventing them:
#
#   openssl rand -hex 32

# --- Credentials the database is created with, on the first start only -------------------------------
#
# Changing one of these afterwards changes nothing: the roles already exist, and the init scripts do not
# run again. Change a password in SQL — ALTER ROLE hostseal PASSWORD '…' — and here, in that order.

# The cluster's bootstrap superuser. hostseal-server never connects as this role, and would refuse to if
# you pointed it at one: a superuser is exempt from every row-level security policy in the schema, which
# is what isolates fleets from one another. See docs/SECURITY.md §5.
POSTGRES_SUPERUSER_PASSWORD=

# The ordinary role the control plane connects as, and the database it owns. The password reaches the
# server as PGPASSWORD rather than inside the connection URL, so every character the database accepts
# works here — / # ? and % are the ones that would otherwise break or quietly change a URL.
HOSTSEAL_DB_USER=hostseal
HOSTSEAL_DB_PASSWORD=
HOSTSEAL_DB_NAME=hostseal

# An external database instead of the postgres service in compose.yaml. Set this and the three values
# above stop being the control plane's connection — they still create the local cluster's roles if you
# leave that service running, so on an external database you would drop it from the stack. Use
# sslmode=verify-full with a root certificate for anything that leaves the host: the default is
# sslmode=disable, which is honest for a connection over the project's own bridge network and for
# nothing else.
# HOSTSEAL_DATABASE_URL=postgres://hostseal@db.example.org:5432/hostseal?sslmode=verify-full

# The role a standby streams as. Created on the first start whether or not a standby ever exists,
# because adding it later means editing pg_hba.conf on a primary that is already serving — at the
# moment somebody is trying to build a replica under time pressure.
HOSTSEAL_REPLICATION_USER=replicator
HOSTSEAL_REPLICATION_PASSWORD=
# Where a standby may connect from, in pg_hba.conf terms. samenet is any subnet this container is
# directly attached to, which inside Compose is this project's network. A standby on another host needs
# a CIDR here, and a network you would be willing to send a copy of the database over.
HOSTSEAL_REPLICATION_HBA=samenet

# --- The control plane -------------------------------------------------------------------------------

# The first account, created on a database that holds none.
#
# There used to be a shared bearer token here, and its removal is the point rather than a
# simplification: one credential for a whole fleet names nobody in the audit trail, cannot be withdrawn
# from one person, and made the two-person approval rule a comparison of a string with itself. Everybody
# gets an account; a script gets a token that belongs to one, issued from the account page.
#
# The address is what you sign in with. Change it before the first start, or leave it and add a real one
# afterwards:
#
#   docker compose exec hostseal-server hostseal-server accounts add --email ops@example.org --name Ops
#   docker compose exec hostseal-server hostseal-server accounts remove --email admin@localhost
#
# Only the first start of an empty database reads either of these. Afterwards the accounts table is the
# truth, and `hostseal-server accounts passwd` is how a password changes.
HOSTSEAL_BOOTSTRAP_EMAIL=admin@localhost

# The first account's password. Leave it empty and the server generates one and prints it, once, where
# `docker compose logs hostseal-server` will show it — which is right for trying this out and wrong for
# an installation somebody has to get back into.
HOSTSEAL_BOOTSTRAP_PASSWORD=

# The fleet this control plane serves. Created on first start if it does not exist.
#
# Running HostSeal for other people means a second kind of account, which administers fleets and reaches
# no fleet's hosts or jobs. There is no setting for it because it is a row:
#
#   docker compose exec hostseal-server hostseal-server accounts add --platform --email you@example.org
#
# Almost every installation has one fleet and needs none of this.
HOSTSEAL_TENANT=default

# --- Where it listens --------------------------------------------------------------------------------

# Only used by compose.yaml's published port, which compose.traefik.yaml removes. The default binds the
# port on every address of the host; 127.0.0.1 is the right answer when something else on the machine is
# the only thing that should reach it.
HOSTSEAL_PUBLISH_ADDR=0.0.0.0
HOSTSEAL_PORT=8443

# --- Traefik, if you use compose.traefik.yaml --------------------------------------------------------

# The name the agents use. It is matched as SNI on a TCP router: Traefik routes the connection and
# hostseal-server terminates it, because a terminating proxy would end the connection that carries an
# agent's client certificate. No public certificate is needed on this name — an agent verifies against
# the CA bundle it was handed at enrolment. The container entrypoint also adds this name to the private
# server certificate. Changing it causes HostSeal to issue a replacement certificate on the next start
# while retaining the existing CA.
HOSTSEAL_AGENT_HOSTNAME=

# The base URL agents reach this control plane at, shown in the interface's enrolment instructions.
#
# Defaults to https://$HOSTSEAL_AGENT_HOSTNAME, which is right unless agents reach the control plane on
# a port other than 443. It cannot be derived from the browser's request: with the UI overlay below,
# the interface is served on a hostname where the agent API is deliberately refused.
HOSTSEAL_AGENT_URL=
HOSTSEAL_TRAEFIK_ENTRYPOINT=websecure

# --- The interface on its own hostname, if you use compose.traefik-ui.yaml ---------------------------

# Where operators open the interface. On this name Traefik terminates TLS and can obtain a Let's Encrypt
# certificate, which is why it is a second name rather than the one above: one hostname cannot be both,
# because a TCP router that matches the SNI wins the connection before any HTTP router sees it.
#
# The agent endpoints are refused on this hostname, deliberately. Point agents at HOSTSEAL_AGENT_HOSTNAME.
HOSTSEAL_UI_HOSTNAME=

# Whatever your Traefik calls its ACME certificate resolver.
HOSTSEAL_CERT_RESOLVER=letsencrypt

# Where a certificate a browser trusts is mounted from, if you supply one. Only read by the commented
# block in compose.traefik.yaml, which expects fullchain.pem and privkey.pem in this directory and
# passes them as --tls-cert/--tls-key. Note that the server reads both once, at startup: a renewal
# takes effect on `docker compose restart hostseal-server` and not before.
# HOSTSEAL_TLS_DIR=./tls

# --- The image ---------------------------------------------------------------------------------------

# Left as it is, `docker compose up` builds the image from this repository. Set HOSTSEAL_IMAGE to a
# published one to deploy without a checkout.
# HOSTSEAL_IMAGE=hostseal-server:local
# HOSTSEAL_VERSION=0.0.0-compose

# --- A standby, if you use compose.standby.yaml ------------------------------------------------------

# The replication slot the standby holds on the primary. Rebuilding a standby means dropping this slot
# on the primary first, or naming a new one here.
HOSTSEAL_STANDBY_SLOT=standby1
