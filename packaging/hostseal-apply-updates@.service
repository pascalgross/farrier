# One instance of the apply-updates root helper, serving one connection.
#
# Started by hostseal-apply-updates.socket, never enabled directly. %i is systemd's per-connection
# instance name, so the journal carries one unit per operation — which is the audit trail an operator
# reads six months later.

[Unit]
Description=HostSeal apply-updates helper (connection %i)
Documentation=file:///usr/share/doc/hostseal-agent/SECURITY.md

# Per-connection instances are garbage-collected even when they fail. Without this, a helper that
# exited non-zero — a refused peer, a request that would not decode — stays behind in the "failed"
# state, and systemd counts it against the socket's MaxConnections for ever. Two of those and the
# socket stops accepting: a host that reports perfectly and can never be patched again, which is
# precisely the kind of permanent wedge this project has closed twice elsewhere.
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/libexec/hostseal/apply-updates --serve

# The connection arrives as standard input. Standard output goes to the journal rather than back down
# the socket: the helper writes its reply to the connection itself, and anything that ever printed to
# stdout — a Go panic, a library's stray Println — would otherwise be spliced into that reply.
StandardInput=socket
StandardOutput=journal
StandardError=journal

# There is deliberately no sandbox here beyond running as root, and the reason is worth stating rather
# than leaving as an omission: this program's job is to install packages. A directive that stopped it
# writing to /usr or /etc would stop it doing the thing it exists for. What bounds it is not a sandbox
# but /etc/hostseal/policy.toml, which it re-reads as root on every invocation, and the closed catalogue,
# which means the only thing it can be asked for is "apply updates".
#
# NoNewPrivileges is *not* set, unlike the other two helpers. dpkg runs maintainer scripts from whatever
# packages the host has installed, and a maintainer script that uses a setuid helper is not HostSeal's to
# break during a security upgrade.
